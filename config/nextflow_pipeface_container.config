
params.vep_db = '/scratch/pawsey0933/long_read/references/homo_sapiens/112_GRCh38/'
params.revel_db = '/software/projects/pawsey0933/long_read/pipeface/references/new_tabbed_revel_grch38.tsv.gz'
params.gnomad_db = '/scratch/pawsey0933/long_read/references/gnomad.joint.v4.1.sites.chrall.vcf.gz'
params.clinvar_db = '/software/projects/pawsey0933/long_read/pipeface/references/clinvar_20240825.vcf.gz'
params.cadd_snv_db = '/scratch/pawsey0933/long_read/references/whole_genome_SNVs.tsv.gz'
params.cadd_indel_db = '/software/projects/pawsey0933/long_read/pipeface/references/gnomad.genomes.r4.0.indel.tsv.gz'
params.cadd_sv_db = '/software/projects/pawsey0933/long_read/pipeface/references/1000G_phase3_SVs.tsv.gz'
params.spliceai_snv_db = '/scratch/pawsey0933/long_read/references/spliceai_scores.raw.snv.hg38.vcf.gz'
params.spliceai_indel_db = '/scratch/pawsey0933/long_read/references/spliceai_scores.raw.indel.hg38.vcf.gz'
params.alphamissense_db = '/software/projects/pawsey0933/long_read/pipeface/references/AlphaMissense_hg38.tsv.gz'
params.clair3_config = "${projectDir}/config/clair3_glnexus.yml"
params.publish_mode = 'copy'

singularity {

    enabled = true
    pullTimeout = '1h'
    cacheDir = '/scratch/pawsey0933/long_read/.nextflow_singularity/'

}

process {

    executor = 'slurm'
    project = 'pawsey0933'
    storage = '/scratch/pawsey0933/long_read'

    withName: 'scrape_settings' {
        queue = 'work'
        cpus = '1'
        memory = '4GB'
        time = '20m'
    }

    withName: 'merge_runs' {
        queue = 'work'
        cpus = '1'
        memory = '4GB'
        time = '6h'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'minimap2' {
        queue = 'work'
        cpus = '16'
        memory = '64GB'
        time = '14h'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'minimod' {
        queue = 'work'
        cpus = '8'
        memory = '32GB'
        disk = '20GB'
        time = '8h'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'mosdepth' {
        queue = 'work'
        cpus = '8'
        memory = '32GB'
        time = '2h'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'clair3_pre_processing' {
        queue = ''
        cpus = '1'
        memory = '4GB'
        time = '30m'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'clair3|clair3_haploid_aware' {
        queue = 'work'
        cpus = '32'
        memory = '128GB'
        time = '24h'
        container = 'hkubal/clair3:v1.0.9'
    }

    withName: 'clair3_post_processing' {
        queue = 'work'
        cpus = '1'
        memory = '4GB'
        disk = '30GB'
        time = '2h'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'deepvariant_dry_run' {
        queue = 'work'
        cpus = '1'
        memory = '4GB'
        time = '20m'
        container = 'google/deepvariant:1.8.0-gpu'
    }

    withName: 'deepvariant_make_examples' {
        queue = 'work'
        cpus = '104'
        memory = '500GB'
        disk = '10GB'
        time = '2h'
        container = 'google/deepvariant:1.8.0-gpu'
    }

    withName: 'deepvariant_call_variants' {
        queue = 'work'
        cpus = '12'
        gpus = '1'
        memory = '96GB'
        disk = '10GB'
        time = '2h'
        container = 'google/deepvariant:1.8.0-gpu'
    }

    withName: 'deepvariant_post_processing' {
        queue = 'work'
        cpus = '14'
        memory = '128GB'
        disk = '30GB'
        time = '3h'
        container = 'google/deepvariant:1.8.0-gpu'
    }

    withName: 'filter_ref_call' {
        queue = 'work'
        cpus = '1'
        memory = '4GB'
        time = '1h'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'split_multiallele|split_multiallele_family' {
        queue = 'work'
        cpus = '1'
        memory = '4GB'
        disk = '10GB'
        time = '1h'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'longtr_pre_processing' {
        queue = ''
        cpus = '1'
        memory = '4GB'
        time = '1h'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'longtr|longtr_family' {
        queue = ''
        cpus = '96'
        memory = '192GB'
        time = '24h'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'concat_tr_vcf|concat_tr_vcf_family' {
        queue = 'work'
        cpus = '1'
        memory = '4GB'
        time = '1h'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'vep_snp_indel|vep_sv' {
        queue = 'work'
        cpus = '32'
        memory = '128GB'
        time = '24h'
        container = 'ensemblorg/ensembl-vep:release_112.0'
    }

    withName: 'whatshap_phase' {
        queue = 'work'
        cpus = '4'
        memory = '16GB'
        time = '24h'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'whatshap_phase_family' {
        queue = 'work'
        cpus = '4'
        memory = '16GB'
        time = '36h'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'whatshap_haplotag' {
        queue = ''
        cpus = '4'
        memory = '16GB'
        time = '10h'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'deeptrio_dry_run' {
        queue = 'work'
        cpus = '1'
        memory = '4GB'
        time = '20m'
        container = 'google/deepvariant:deeptrio-1.8.0-gpu'
    }

    withName: 'deeptrio_make_examples' {
        queue = 'work'
        cpus = '104'
        memory = '500GB'
        disk = '10GB'
        time = '12h'
        container = 'google/deepvariant:deeptrio-1.8.0-gpu'
    }

    withName: 'deeptrio_call_variants' {
        queue = 'work'
        cpus = '12'
        gpus = '1'
        memory = '96GB'
        disk = '1GB'
        time = '6h'
        container = 'google/deepvariant:deeptrio-1.8.0-gpu'
    }

    withName: 'deeptrio_postprocessing' {
        queue = 'work'
        cpus = '14'
        memory = '128GB'
        disk = '10GB'
        time = '3h'
        container = 'google/deepvariant:deeptrio-1.8.0-gpu'
    }

    withName: 'somalier_extract|somalier_relate' {
        queue = 'work'
        cpus = '1'
        memory = '4GB'
        time = '1h'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'glnexus_pre_processing' {
        queue = 'work'
        cpus = '1'
        memory = '4GB'
        time = '3h'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'glnexus' {
        queue = 'work'
        cpus = '1'
        memory = '96GB'
        time = '2h'
        container = 'ghcr.io/dnanexus-rnd/glnexus:v1.4.3'
    }

    withName: 'glnexus_post_processing' {
        queue = 'work'
        cpus = '1'
        memory = '4GB'
        time = '30m'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'sniffles' {
        queue = 'work'
        cpus = '4'
        memory = '16GB'
        time = '1h'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'cutesv' {
        queue = 'work'
        cpus = '8'
        memory = '32GB'
        time = '1h'
        container = 'leahkemp/pipeface:0.0.4'
    }

    withName: 'jasmine' {
        queue = 'work'
        cpus = '8'
        memory = '32GB'
        time = '12h'
        container = 'leahkemp/pipeface:0.0.4'
    }

}

