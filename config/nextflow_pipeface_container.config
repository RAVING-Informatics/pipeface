
params.vep_db = '/scratch/pawsey0933/long_read/references/homo_sapiens/112_GRCh38/'
params.revel_db = '/software/projects/pawsey0933/long_read/pipeface/references/new_tabbed_revel_grch38.tsv.gz'
params.gnomad_db = '/scratch/pawsey0933/long_read/references/gnomad.joint.v4.1.sites.chrall.vcf.gz'
params.clinvar_db = '/software/projects/pawsey0933/long_read/pipeface/references/clinvar_20240825.vcf.gz'
params.cadd_snv_db = '/scratch/pawsey0933/long_read/references/whole_genome_SNVs.tsv.gz'
params.cadd_indel_db = '/software/projects/pawsey0933/long_read/pipeface/references/gnomad.genomes.r4.0.indel.tsv.gz'
params.cadd_sv_db = '/software/projects/pawsey0933/long_read/pipeface/references/1000G_phase3_SVs.tsv.gz'
params.spliceai_snv_db = '/scratch/pawsey0933/long_read/references/spliceai_scores.raw.snv.hg38.vcf.gz'
params.spliceai_indel_db = '/scratch/pawsey0933/long_read/references/spliceai_scores.raw.indel.hg38.vcf.gz'
params.alphamissense_db = '/software/projects/pawsey0933/long_read/pipeface/references/AlphaMissense_hg38.tsv.gz'

singularity {

    enabled = true
    pullTimeout = '1h'
    cacheDir = '/scratch/pawsey0933/long_read/.nextflow_singularity/'

}

process {

    executor = 'slurm'
    project = 'pawsey0933'
    storage = '/scratch/pawsey0933/long_read'

    withName: 'scrape_settings' {
        queue = 'local'
        cpus = '1'
        memory = '4GB'
        time = '20m'
    }

    withName: 'merge_runs' {
        queue = 'local'
        cpus = '1'
        memory = '4GB'
        time = '6h'
        container = 'leahkemp/pipeface:0.0.1'
    }

    withName: 'minimap2' {
        queue = 'work'
        cpus = '16'
        memory = '64GB'
        time = '14h'
        container = 'leahkemp/pipeface:0.0.1'
    }

    withName: 'minimod' {
        queue = 'work'
        cpus = '8'
        memory = '32GB'
        disk = '20GB'
        time = '4h'
        container = 'leahkemp/pipeface:0.0.1'
    }

    withName: 'mosdepth' {
        queue = 'work'
        cpus = '8'
        memory = '32GB'
        time = '2h'
        container = 'leahkemp/pipeface:0.0.1'
    }

    withName: 'clair3|clair3_haploid_aware' {
        queue = 'work'
        cpus = '32'
        memory = '128GB'
        disk = '20GB'
        time = '16h'
        container = 'hkubal/clair3:v1.0.9'
    }

    withName: 'clair3_pre_processing|clair3_post_processing' {
        queue = 'local'
        cpus = '1'
        memory = '4GB'
        time = '30m'
        container = 'leahkemp/pipeface:0.0.1'
    }

    withName: 'clair3_post_processing' {
        queue = 'local'
        cpus = '1'
        memory = '4GB'
        disk = '10GB'
        time = '30m'
        container = 'leahkemp/pipeface:0.0.1'
    }

    withName: 'deepvariant_dry_run' {
        queue = 'work'
        cpus = '1'
        memory = '4GB'
        time = '20m'
        container = 'google/deepvariant:1.8.0-gpu'
    }

    withName: 'deepvariant_make_examples' {
        queue = 'work'
        cpus = '104'
        memory = '500GB'
        disk = '10GB'
        time = '2h'
        container = 'google/deepvariant:1.8.0-gpu'
    }

    withName: 'deepvariant_call_variants' {
        queue = 'work'
        cpus = '12'
        gpus = '1'
        memory = '96GB'
        disk = '10GB'
        time = '2h'
        container = 'google/deepvariant:1.8.0-gpu'
    }

    withName: 'deepvariant_post_processing' {
        queue = 'work'
        cpus = '14'
        memory = '128GB'
        disk = '10GB'
        time = '1h'
        container = 'google/deepvariant:1.8.0-gpu'
    }

    withName: 'filter_ref_call' {
        queue = 'local'
        cpus = '1'
        memory = '4GB'
        time = '1h'
        container = 'leahkemp/pipeface:0.0.1'
    }

    withName: 'split_multiallele|split_multiallele_duo|split_multiallele_trio' {
        queue = 'local'
        cpus = '1'
        memory = '4GB'
        disk = '10GB'
        time = '1h'
        container = 'leahkemp/pipeface:0.0.1'
    }

    withName: 'vep_snp_indel|vep_sniffles_sv|vep_cutesv_sv' {
        queue = 'work'
        cpus = '32'
        memory = '128GB'
        time = '24h'
        container = 'ensemblorg/ensembl-vep:release_112.0'
    }

    withName: 'whatshap_phase|whatshap_haplotag' {
        queue = 'work'
        cpus = '4'
        memory = '16GB'
        time = '10h'
        container = 'leahkemp/pipeface:0.0.1'
    }

    withName: 'whatshap_phase_duo|whatshap_phase_trio' {
        queue = 'work'
        cpus = '4'
        memory = '16GB'
        time = '36h'
        container = 'leahkemp/pipeface:0.0.1'
    }

    withName: 'deeptrio_dry_run' {
        queue = 'work'
        cpus = '1'
        memory = '4GB'
        time = '20m'
        container = 'google/deepvariant:deeptrio-1.8.0-gpu'
    }

    withName: 'deeptrio_make_examples' {
        queue = 'work'
        cpus = '104'
        memory = '500GB'
        disk = '10GB'
        time = '12h'
        container = 'google/deepvariant:deeptrio-1.8.0-gpu'
    }

    withName: 'deeptrio_call_variants' {
        queue = 'work'
        cpus = '12'
        gpus = '1'
        memory = '96GB'
        disk = '1GB'
        time = '6h'
        container = 'google/deepvariant:deeptrio-1.8.0-gpu'
    }

    withName: 'deeptrio_postprocessing' {
        queue = 'work'
        cpus = '14'
        memory = '128GB'
        disk = '10GB'
        time = '3h'
        container = 'google/deepvariant:deeptrio-1.8.0-gpu'
    }

    withName: 'somalier_duo|somalier_trio' {
        queue = 'local'
        cpus = '1'
        memory = '4GB'
        time = '1h'
        container = 'leahkemp/pipeface:0.0.1'
    }

    withName: 'glnexus_duo|glnexus_trio' {
        queue = 'work'
        cpus = '1'
        memory = '96GB'
        time = '2h'
        container = 'ghcr.io/dnanexus-rnd/glnexus:v1.4.3'
    }

    withName: 'glnexus_post_processing_duo|glnexus_post_processing_trio' {
        queue = 'local'
        cpus = '1'
        memory = '4GB'
        time = '30m'
        container = 'leahkemp/pipeface:0.0.1'
    }

    withName: 'sniffles' {
        queue = 'work'
        cpus = '4'
        memory = '16GB'
        time = '1h'
        container = 'leahkemp/pipeface:0.0.1'
    }

    withName: 'cutesv' {
        queue = 'work'
        cpus = '8'
        memory = '32GB'
        time = '1h'
        container = 'leahkemp/pipeface:0.0.1'
    }

    withName: 'jasmine_sniffles_duo|jasmine_cutesv_duo|jasmine_sniffles_trio|jasmine_cutesv_trio' {
        queue = 'work'
        cpus = '8'
        memory = '32GB'
        time = '12h'
        container = 'leahkemp/pipeface:0.0.1'
    }

}

